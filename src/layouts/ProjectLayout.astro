---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

interface Props {
  project: CollectionEntry<"projects">;
  headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const d = project.data;

// TOC: chapter headings (h2) + an appended Gallery entry when present.
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, text: h.text }));
if (d.gallery.length) toc.push({ slug: "gallery", text: "Gallery" });

const typeLine = d.tags.join(", ");
const headerMeta = [d.year, d.role, typeLine].filter(Boolean).join(" · ");

const ogDesc = `${d.title} — a project by Ethan Sheaf-Morrison.${
  headerMeta ? " " + headerMeta + "." : ""
}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: d.title,
  description: d.summary,
  url: canonical,
  image: new URL(d.cover, Astro.site).href,
  dateCreated: d.date.toISOString().slice(0, 10),
  author: { "@type": "Person", name: "Ethan Sheaf-Morrison" },
  keywords: d.tags.join(", "),
};
---

<BaseLayout
  title={`${d.title} — Ethan Sheaf-Morrison`}
  description={d.summary || ogDesc}
  ogType="article"
  ogImage={d.cover}
  jsonLd={jsonLd}
  showFooter={true}
>
  <header class="cin-header">
    <span class="cin-header-index">Project</span>
    <h1 class="cin-header-title">{d.title}</h1>
    {headerMeta && <p class="cin-header-meta">{headerMeta}</p>}
    {d.researchQuestion && <p class="cin-research-q">{d.researchQuestion}</p>}
    {
      d.externalUrl && (
        <p class="cin-header-meta" style="margin-top:0.75rem">
          <a href={d.externalUrl} target="_blank" rel="noopener" style="text-decoration:underline">
            Visit the live project ↗
          </a>
        </p>
      )
    }
  </header>

  <div class="cin-content">
    <aside class="cin-rail">
      <ol class="cin-toc">
        {
          toc.map((item, i) => (
            <li class:list={["cin-toc-item", { active: i === 0 }]} data-chapter={item.slug}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))
        }
      </ol>
      <dl class="cin-rail-meta">
        {d.year && (<><dt>Year</dt><dd>{d.year}</dd></>)}
        {d.role && (<><dt>Role</dt><dd>{d.role}</dd></>)}
        {d.methods.length > 0 && (<><dt>Methods</dt><dd>{d.methods.join(", ")}</dd></>)}
        {d.outputs.length > 0 && (<><dt>Outputs</dt><dd>{d.outputs.join(", ")}</dd></>)}
        {typeLine && (<><dt>Type</dt><dd>{typeLine}</dd></>)}
        {d.contribution && (<><dt>Contribution</dt><dd>{d.contribution}</dd></>)}
      </dl>
    </aside>

    <main class="cin-chapters">
      <slot />

      {
        d.gallery.length > 0 && (
          <>
            <h2 id="gallery">Gallery</h2>
            <div class="cin-gallery">
              {d.gallery.map((g) => (
                <figure class="cin-gallery-figure">
                  <img src={g.src} alt={g.alt ?? ""} loading="lazy" decoding="async" />
                  {g.alt && <figcaption>{g.alt}</figcaption>}
                </figure>
              ))}
            </div>
          </>
        )
      }
    </main>
  </div>

  {
    d.gallery.length > 1 && (
      <section class="cin-strip" aria-label="Project gallery">
        {d.gallery.map((g) => (
          <img src={g.src} alt="" loading="lazy" decoding="async" />
        ))}
      </section>
    )
  }

  <script>
    // Scrollspy: highlight the TOC item for the chapter currently in view.
    const tocItems = document.querySelectorAll<HTMLElement>(".cin-toc-item");
    const heads = document.querySelectorAll<HTMLElement>(".cin-chapters > h2[id]");

    function activate(id: string) {
      tocItems.forEach((i) => i.classList.toggle("active", i.dataset.chapter === id));
    }
    if (heads[0]) activate(heads[0].id);

    if (heads.length) {
      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) activate((e.target as HTMLElement).id);
          }
        },
        { rootMargin: "0px 0px -70% 0px", threshold: 0 }
      );
      heads.forEach((h) => obs.observe(h));
    }

    // Reveal inline figures, diagrams, and embeds on scroll.
    const figures = document.querySelectorAll<HTMLElement>(
      ".cin-inline-figure, .cin-diagram, .cin-embed"
    );
    if (figures.length) {
      const figObs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("revealed");
              figObs.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      figures.forEach((f) => {
        f.classList.add("cin-anim-ready");
        figObs.observe(f);
      });
    }

    // Lightbox over inline + gallery images.
    const imgs = Array.from(
      document.querySelectorAll<HTMLImageElement>(".cin-inline-figure img, .cin-gallery img")
    );
    if (imgs.length) {
      const lb = document.createElement("div");
      lb.id = "lightbox";
      lb.className = "lightbox";
      lb.innerHTML =
        '<span class="lightbox-close">&times;</span>' +
        '<div class="lightbox-content"><img class="lightbox-img" id="lightbox-img" alt="">' +
        '<div class="lightbox-nav"><span class="lightbox-prev">&#10094;</span>' +
        '<span class="lightbox-next">&#10095;</span></div></div>' +
        '<div class="lightbox-caption" id="lightbox-caption"></div>';
      document.body.appendChild(lb);

      const lbImg = lb.querySelector<HTMLImageElement>("#lightbox-img")!;
      const lbCap = lb.querySelector<HTMLElement>("#lightbox-caption")!;
      let idx = 0;

      const show = (i: number) => {
        idx = (i + imgs.length) % imgs.length;
        lbImg.src = imgs[idx].src;
        lbCap.textContent = imgs[idx].alt || "";
      };
      const open = (i: number) => {
        show(i);
        lb.classList.add("active");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        lb.classList.remove("active");
        document.body.style.overflow = "";
      };

      imgs.forEach((img, i) => {
        img.style.cursor = "pointer";
        img.addEventListener("click", () => open(i));
      });
      lb.querySelector(".lightbox-close")!.addEventListener("click", close);
      lb.addEventListener("click", (e) => {
        if (e.target === lb) close();
      });
      lb.querySelector(".lightbox-prev")!.addEventListener("click", () => show(idx - 1));
      lb.querySelector(".lightbox-next")!.addEventListener("click", () => show(idx + 1));
      document.addEventListener("keydown", (e) => {
        if (!lb.classList.contains("active")) return;
        if (e.key === "Escape") close();
        else if (e.key === "ArrowLeft") show(idx - 1);
        else if (e.key === "ArrowRight") show(idx + 1);
      });
    }
  </script>
</BaseLayout>
