---
// Book-style flipbook — pages through an ordered set of spreads one at a time,
// with prev/next controls, a page counter, click-to-turn (left/right halves),
// and keyboard arrows. Root class `cin-flipbook` (NOT `cin-inline-figure`) so
// the ProjectLayout lightbox leaves it alone; each instance wires itself up so
// multiple flipbooks on a page coexist. Styling lives in cinematic.css.
interface Page {
  src: string;
  alt?: string;
}
interface Props {
  pages: Page[];
  caption?: string;
}
const { pages = [], caption } = Astro.props;
const total = pages.length;
const pad = (n: number) => String(n).padStart(2, "0");
---
<figure class="cin-flipbook" data-total={total}>
  <div class="cin-flipbook-stage" tabindex="0" role="group" aria-roledescription="flipbook" aria-label="Style guide — page through the spreads">
    <div class="cin-flipbook-track">
      {pages.map((p, i) => (
        <div class="cin-flipbook-page" data-index={i} aria-hidden={i === 0 ? "false" : "true"}>
          <img
            src={p.src}
            alt={p.alt ?? `Iterate style guide — page ${i + 1} of ${total}`}
            loading={i < 2 ? "eager" : "lazy"}
            decoding="async"
            draggable="false"
          />
        </div>
      ))}
    </div>
    <button class="cin-flipbook-edge cin-flipbook-edge--prev" data-dir="-1" type="button" aria-label="Previous page"></button>
    <button class="cin-flipbook-edge cin-flipbook-edge--next" data-dir="1" type="button" aria-label="Next page"></button>
  </div>
  <div class="cin-flipbook-controls">
    <button class="cin-flipbook-btn" data-dir="-1" type="button" aria-label="Previous page">&#8592;</button>
    <span class="cin-flipbook-counter">
      <span class="cin-flipbook-current">{pad(1)}</span> / {pad(total)}
    </span>
    <button class="cin-flipbook-btn" data-dir="1" type="button" aria-label="Next page">&#8594;</button>
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".cin-flipbook").forEach((book) => {
    const total = Number(book.dataset.total || "0");
    if (total < 1) return;
    const track = book.querySelector<HTMLElement>(".cin-flipbook-track");
    const pages = Array.from(book.querySelectorAll<HTMLElement>(".cin-flipbook-page"));
    const current = book.querySelector<HTMLElement>(".cin-flipbook-current");
    const stage = book.querySelector<HTMLElement>(".cin-flipbook-stage");
    let idx = 0;

    const pad = (n: number) => String(n).padStart(2, "0");

    function go(next: number, dir: number) {
      const clamped = Math.max(0, Math.min(total - 1, next));
      if (clamped === idx) return;
      book.classList.remove("is-turn-fwd", "is-turn-back");
      // force reflow so the animation restarts even on rapid clicks
      void book.offsetWidth;
      book.classList.add(dir > 0 ? "is-turn-fwd" : "is-turn-back");
      idx = clamped;
      if (track) track.style.transform = `translateX(${-idx * 100}%)`;
      if (current) current.textContent = pad(idx + 1);
      pages.forEach((p, i) => p.setAttribute("aria-hidden", i === idx ? "false" : "true"));
      book.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) => {
        const d = Number(b.dataset.dir);
        b.toggleAttribute("disabled", (d < 0 && idx === 0) || (d > 0 && idx === total - 1));
      });
    }

    book.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) => {
      const d = Number(b.dataset.dir);
      b.addEventListener("click", () => go(idx + d, d));
    });

    stage?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(idx + 1, 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); go(idx - 1, -1); }
    });

    // initial disabled state
    book.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) => {
      if (Number(b.dataset.dir) < 0) b.toggleAttribute("disabled", true);
    });
  });
</script>
