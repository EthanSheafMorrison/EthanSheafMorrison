---
// Site top bar — matches the codex landing-page navbar (wordmark left, nav
// right, monochrome Geist). Lives inside #site-header (sticky) from base.css.
// Shown ≥768px; MobileNav takes over below. Styles: .sitebar in codex.css.
const path = Astro.url.pathname;
---
<header class="sitebar">
  <a class="sitebar-wordmark" href="/">Ethan Sheaf-Morrison</a>
  <nav class="sitebar-nav" aria-label="Primary">
    <a href="/#work">Work</a>
    <a href="/#about">About</a>
    <a href="/cv" aria-current={path.startsWith("/cv") ? "page" : undefined}>CV</a>
  </nav>
</header>
