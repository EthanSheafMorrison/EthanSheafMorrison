---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CV — Ethan Sheaf-Morrison">
  <main class="cv-content">
    <div class="cv-layout">
      <div class="cv-left-column">
        <div class="cv-name"><h1>Ethan Sheaf-Morrison</h1></div>
        <div class="cv-location"><p>Pōneke, Aotearoa</p></div>
        <div class="cv-title"><h2>Designer & Researcher</h2></div>
      </div>

      <div class="cv-right-column">
        <div class="cv-section">
          <h3 class="section-title">Professional Profile</h3>
          <div class="section-content">
            <p>
              Multidisciplinary designer specializing in critical cartography, world-building, and
              design in language. Focused on creating innovative solutions that bridge technology and
              creative practice through mapping projects and data visualizations.
            </p>
          </div>
        </div>

        <div class="cv-section">
          <h3 class="section-title">Experience</h3>
          <div class="section-content">
            <div class="experience-item">
              <div class="experience-header">
                <h4>Teaching Fellow</h4>
                <span class="experience-date">2025 - Present</span>
              </div>
              <p class="experience-company">Te Herenga Waka — Victoria University of Wellington</p>
              <p class="experience-role">Concept Art & World Building</p>
              <p class="experience-role">Photography & Graphic Design</p>
            </div>
            <div class="experience-item">
              <div class="experience-header">
                <h4>Research Assistant</h4>
                <span class="experience-date">2021 - Present</span>
              </div>
              <p class="experience-company">Te Herenga Waka — Victoria University of Wellington</p>
              <ul class="experience-details">
                <li>Summer Research Scholar (2022-2023)</li>
                <li>Research support and data analysis</li>
                <li>Academic writing and documentation</li>
              </ul>
            </div>
            <div class="experience-item">
              <div class="experience-header">
                <h4>Tutor</h4>
                <span class="experience-date">2021 - Present</span>
              </div>
              <p class="experience-company">Te Herenga Waka — Victoria University of Wellington</p>
              <ul class="experience-details">
                <li>Teaching assistant for design courses</li>
                <li>Student mentorship and guidance</li>
                <li>Course material development</li>
              </ul>
            </div>
            <div class="experience-item">
              <div class="experience-header">
                <h4>Photojournalist</h4>
                <span class="experience-date">2022</span>
              </div>
              <p class="experience-company">Bloomberg</p>
            </div>
          </div>
        </div>

        <div class="cv-section">
          <h3 class="section-title">Education</h3>
          <div class="section-content">
            <div class="education-item">
              <div class="education-header">
                <h4>Masters of Design (With Distinction)</h4>
                <span class="education-date">2024 - 2025</span>
              </div>
              <p class="education-institution">Te Herenga Waka — Victoria University of Wellington</p>
              <p class="education-major">Major in Media Design</p>
            </div>
            <div class="education-item">
              <div class="education-header">
                <h4>Bachelor of Design Innovation</h4>
                <span class="education-date">2020 - 2023</span>
              </div>
              <p class="education-institution">Te Herenga Waka — Victoria University of Wellington</p>
              <p class="education-major">Double major in Communication and Media Design</p>
            </div>
          </div>
        </div>

        <div class="cv-section">
          <h3 class="section-title">Skills</h3>
          <div class="section-content">
            <div class="skills-grid">
              <div class="skills-column">
                <ul>
                  <li>Critical Cartography</li>
                  <li>World Building</li>
                  <li>Visual Communication</li>
                  <li>User Experience Design</li>
                  <li>Information Design</li>
                </ul>
              </div>
              <div class="skills-column">
                <ul>
                  <li>Typography</li>
                  <li>Academic Writing</li>
                  <li>Data Analysis</li>
                  <li>Qualitative Research</li>
                  <li>Project Management</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="cv-section">
          <h3 class="section-title">Languages</h3>
          <div class="section-content">
            <p>English - Native</p>
            <p>Te Reo Māori - Basic</p>
          </div>
        </div>

        <div class="cv-section">
          <h3 class="section-title">Software</h3>
          <div class="section-content">
            <div class="software-grid">
              {
                [
                  ["AI", "Adobe Illustrator"],
                  ["PS", "Photoshop"],
                  ["ID", "InDesign"],
                  ["XD", "Adobe XD"],
                  ["PR", "Premiere Pro"],
                  ["AE", "After Effects"],
                  ["F", "Figma"],
                  ["3D", "Three.js"],
                  ["JS", "JavaScript"],
                  ["HTML", "HTML/CSS"],
                ].map(([icon, name]) => (
                  <div class="software-item">
                    <div class="software-icon">{icon}</div>
                    <span>{name}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="cv-section">
          <h3 class="section-title">Contact</h3>
          <div class="section-content">
            <p>+64 21 123 4567</p>
            <p><a href="mailto:ethan.sheafmorrison@gmail.com">ethan.sheafmorrison@gmail.com</a></p>
          </div>
        </div>

        <div class="cv-section">
          <h3 class="section-title">Social Media</h3>
          <div class="section-content">
            <p><a href="https://www.linkedin.com/in/ethan-sheaf-morrison-a2b7451b7/" target="_blank" rel="noopener">LinkedIn</a> - Ethan Sheaf-Morrison</p>
            <p><a href="https://github.com/EthanSheafMorrison" target="_blank" rel="noopener">GitHub</a> - EthanSheafMorrison</p>
            <p><a href="https://www.instagram.com/ethan.sheaf/" target="_blank" rel="noopener">Instagram</a> - @ethan.sheaf</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
